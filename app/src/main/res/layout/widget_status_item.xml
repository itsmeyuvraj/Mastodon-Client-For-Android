<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF2A2A3E"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Reblog indicator -->
    <TextView
        android:id="@+id/widget_item_reblog_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:textColor="#AA9999BB"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Author row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_item_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AA9999BB"
            android:textSize="10sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_item_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#AA9999BB"
        android:textSize="10sp" />

    <!-- Status content -->
    <TextView
        android:id="@+id/widget_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#DDDDE0"
        android:textSize="12sp" />

    <!-- Stats -->
    <TextView
        android:id="@+id/widget_item_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#888899"
        android:textSize="10sp" />

</LinearLayout>
